// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

model Permit {
  id             Int        @id @default(autoincrement())
  permitNo       String     @unique       
  applicationNum String     @unique        
  altitudeFt     Int
  class          Int
  fullText        String?
  coordinates     String?                  
  activities     Activity[]
  createdAt     DateTime  @default(now())
}

model Activity {
  id                Int         @id @default(autoincrement())
  permitId          Int
  permit            Permit      @relation(fields: [permitId], references: [id], onDelete: Cascade) //onDelete cascade refers to which field?
  activityDate String            // "30 May 2026" 

  activityTime      String     
  activityDateTime DateTime
  status            String      @default("N")
  mref              String?    // set when NOTAM taken
  createdAt         DateTime    @default(now())
  takenBy           String?    // set when NOTAM taken

  @@unique([permitId, activityDate, activityTime])
  @@index([status, activityDateTime])
}

model User {
   id    Int  @id @default(autoincrement())
   username String @unique
   email String @unique
   passwordHash String
   session Session?
   disabled Boolean @default(false)
   createdAt    DateTime @default(now())
}

model Session {
  userId Int @id // 0 or 1:1 rs
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sid String @unique
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  expiresAt DateTime

}